{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.speechrouter.ai/catalog.schema.json",
  "title": "SpeechRouter Model Catalog Entry v0",
  "description": "One entry per model in GET /v1/models. The capability matrix that powers routing, validation, docs, and the public model pages.",
  "type": "object",
  "required": [
    "slug",
    "provider",
    "kind",
    "pricing",
    "capabilities"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$",
      "description": "e.g. deepgram/nova-3, elevenlabs/scribe-v1"
    },
    "provider": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "kind": {
      "enum": [
        "stt",
        "tts",
        "live"
      ]
    },
    "modes": {
      "type": "array",
      "items": {
        "enum": [
          "streaming",
          "batch",
          "live"
        ]
      }
    },
    "pricing": {
      "type": "object",
      "description": "Vendor list price in native billing units. Pass-through: this is exactly what we charge. STT: exactly one seconds-based rate (per_audio_*, per_session_hour). TTS/live: one or more unit rates priced against usage `units` (characters, per-1M token counts by modality). Contract: PLAN-tts-live.md §3.0.",
      "properties": {
        "per_audio_second_usd": {
          "type": "number"
        },
        "per_audio_minute_usd": {
          "type": "number"
        },
        "per_audio_hour_usd": {
          "type": "number"
        },
        "per_session_hour_usd": {
          "type": "number",
          "description": "wall-clock WS-open time (Soniox, AssemblyAI streaming)"
        },
        "per_character_usd": {
          "type": "number",
          "description": "TTS: per Unicode code point of input text"
        },
        "minimum_usd": {
          "type": "number",
          "description": "per-request vendor floor (AWS 15s, Groq 10s)"
        },
        "per_1m_text_input_tokens_usd": {
          "type": "number",
          "description": "per 1,000,000 text input tokens"
        },
        "per_1m_cached_text_input_tokens_usd": {
          "type": "number",
          "description": "per 1,000,000 cached text input tokens"
        },
        "per_1m_audio_input_tokens_usd": {
          "type": "number",
          "description": "per 1,000,000 audio input tokens"
        },
        "per_1m_cached_audio_input_tokens_usd": {
          "type": "number",
          "description": "per 1,000,000 cached audio input tokens"
        },
        "per_1m_image_input_tokens_usd": {
          "type": "number",
          "description": "per 1,000,000 image input tokens"
        },
        "per_1m_text_output_tokens_usd": {
          "type": "number",
          "description": "per 1,000,000 text output tokens"
        },
        "per_1m_audio_output_tokens_usd": {
          "type": "number",
          "description": "per 1,000,000 audio output tokens"
        },
        "per_utf8_byte_usd": {
          "type": "number",
          "description": "TTS: per UTF-8 byte of input text (Fish Audio); priced against units.utf8_bytes"
        },
        "per_1m_cached_image_input_tokens_usd": {
          "type": "number",
          "description": "per 1,000,000 cached image input tokens"
        },
        "per_second_usd": {
          "type": "number",
          "deprecated": true,
          "description": "DERIVED by the gateway for legacy consumers of seconds-priced (STT) models only; do not author"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "diarization": {
          "type": "boolean"
        },
        "word_timestamps": {
          "type": "boolean"
        },
        "interim_results": {
          "type": "boolean"
        },
        "endpointing": {
          "type": "boolean"
        },
        "keyword_boosting": {
          "type": "boolean"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "BCP-47; [\"auto\"] = autodetect"
        },
        "encodings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sample_rates": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "voices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "TTS/live: provider-native voice ids accepted by `voice`"
        },
        "max_audio_seconds": {
          "type": "number",
          "description": "batch upload limit"
        },
        "default_voice": {
          "type": "string",
          "description": "TTS/live: voice used when the request names none"
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "TTS: response_format values (mp3, opus, aac, flac, wav, pcm, mulaw, alaw)"
        },
        "max_input_chars": {
          "type": "integer",
          "description": "TTS: input text limit per request"
        },
        "instructions": {
          "type": "boolean",
          "description": "TTS: accepts a style prompt (`instructions`)"
        },
        "speed": {
          "type": "boolean",
          "description": "TTS: accepts `speed`"
        },
        "input_sample_rates": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "live: accepted input audio rates"
        },
        "output_sample_rates": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "live/TTS: produced audio rates"
        },
        "tools": {
          "type": "boolean",
          "description": "live: function calling"
        },
        "max_session_seconds": {
          "type": "number",
          "description": "live: upstream session cap"
        },
        "custom_voices": {
          "type": "boolean",
          "description": "TTS: voice ids beyond `voices` (cloned / library / account voices) are accepted and validated by the provider"
        }
      }
    },
    "latency": {
      "type": "object",
      "description": "Measured by our benchmark harness, refreshed nightly",
      "properties": {
        "ttfb_ms_p50": {
          "type": "number"
        },
        "ttfb_ms_p95": {
          "type": "number"
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "hipaa_eligible": {
      "type": "boolean",
      "description": "Provider offers BAA + zero-retention for this model"
    },
    "deprecated": {
      "type": "boolean"
    },
    "dialect": {
      "enum": [
        "openai-realtime",
        "gemini-live"
      ],
      "description": "live only: the provider-native WebSocket protocol the client speaks (use that vendor's SDK pointed at the gateway)"
    },
    "pricing_schedule": {
      "type": "array",
      "description": "Dated price changes. The rate set in force on a UTC date is the latest step with effective_from <= that date, else `pricing`. GET /v1/models serves `pricing` already resolved to today.",
      "items": {
        "type": "object",
        "required": [
          "effective_from",
          "pricing"
        ],
        "properties": {
          "effective_from": {
            "type": "string",
            "format": "date"
          },
          "pricing": {
            "$ref": "#/properties/pricing"
          }
        },
        "additionalProperties": false
      }
    },
    "pricing_source": {
      "type": "string",
      "description": "Where the list price was read (URL + notes)"
    },
    "pricing_checked": {
      "type": "string",
      "format": "date",
      "description": "When pricing_source was last checked"
    },
    "notes": {
      "type": "string",
      "description": "Human-readable caveats (billing quirks, limits)"
    }
  }
}
