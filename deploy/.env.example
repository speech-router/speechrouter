# Copy to .env and fill in what you need. Every value is optional except
# SPEECHROUTER_KEYS — a provider with no credentials is simply unavailable
# (its models 404 at resolve time), so a single-vendor self-host is fine.

# --- gateway auth -----------------------------------------------------------
# Comma-separated API keys your own clients will present.
SPEECHROUTER_KEYS=sk_local_dev

SPEECHROUTER_KEYSTORE=local
SPEECHROUTER_USAGE_EMITTER=log

# --- session guards ---------------------------------------------------------
SPEECHROUTER_MAX_CONCURRENT_STREAMS=20
SPEECHROUTER_IDLE_TIMEOUT_SECONDS=60
SPEECHROUTER_RING_BUFFER_SECONDS=10

# --- provider credentials ---------------------------------------------------
SPEECHROUTER_DEEPGRAM_API_KEY=
SPEECHROUTER_SONIOX_API_KEY=
SPEECHROUTER_ASSEMBLYAI_API_KEY=
SPEECHROUTER_SPEECHMATICS_API_KEY=
SPEECHROUTER_OPENAI_API_KEY=
SPEECHROUTER_GROQ_API_KEY=
SPEECHROUTER_MISTRAL_API_KEY=
SPEECHROUTER_CARTESIA_API_KEY=
SPEECHROUTER_ELEVENLABS_API_KEY=
SPEECHROUTER_TELNYX_API_KEY=

# Palabra: one API key from platform.palabra.ai/api-keys (there is no
# client id/secret pair). STT is served from the `eu` region only today.
SPEECHROUTER_PALABRA_API_KEY=
SPEECHROUTER_PALABRA_REGION=eu
# Optional: full ASR stream URL, overrides the region.
# SPEECHROUTER_PALABRA_WS_BASE=

# Gemini Live transcription: a Gemini API key from aistudio.google.com.
# Nothing to do with SPEECHROUTER_GOOGLE_* below -- that is Google Cloud
# Speech-to-Text, a different product with a different credential.
SPEECHROUTER_GEMINI_API_KEY=

# Meta Model API key (Muse Voice Transcribe), from the Model API dashboard.
SPEECHROUTER_META_API_KEY=

# Multi-field credentials (not BYOK-able yet)
SPEECHROUTER_AZURE_SPEECH_KEY=
SPEECHROUTER_AZURE_SPEECH_REGION=
SPEECHROUTER_AWS_ACCESS_KEY_ID=
SPEECHROUTER_AWS_SECRET_ACCESS_KEY=
SPEECHROUTER_AWS_REGION=us-east-1
SPEECHROUTER_GOOGLE_PROJECT_ID=
SPEECHROUTER_GOOGLE_CREDENTIALS_JSON=

# --- observability (empty disables) -----------------------------------------
SPEECHROUTER_SENTRY_DSN=
SPEECHROUTER_LOGTAIL_SOURCE_TOKEN=
