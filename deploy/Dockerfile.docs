# docs.speechrouter.ai — static Starlight site, served by nginx.
# Build context is the repo root: the provider pages are generated from
# gateway/…/providers/*/models.json at build time.

FROM node:22-slim AS build
WORKDIR /src
COPY docs-site/package.json docs-site/package-lock.json docs-site/
RUN cd docs-site && npm ci
COPY gateway/speechrouter_gateway/providers gateway/speechrouter_gateway/providers
COPY docs-site docs-site
RUN cd docs-site && npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/docs-site/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 8080;\n  root /usr/share/nginx/html;\n  gzip on;\n  gzip_types text/css application/javascript application/json image/svg+xml;\n  location = /up { return 200 "ok"; }\n  location / { try_files $uri $uri/index.html $uri.html =404; }\n  error_page 404 /404.html;\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 8080
